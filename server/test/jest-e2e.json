{
  "moduleFileExtensions": [
    "js",
    "mjs",
    "json",
    "ts"
  ],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": "\\.e2e-spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest",
    "^.+\\.mjs$": [
      "@swc/jest",
      {
        "module": {
          "type": "commonjs"
        }
      }
    ]
  },
  "transformIgnorePatterns": [
    "/node_modules/(?!rou3/)"
  ]
}
