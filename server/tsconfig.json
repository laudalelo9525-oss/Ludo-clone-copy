{
  "compilerOptions": {
    /* NestJS runs on CommonJS; Colyseus ships a CJS build behind its
       `exports` map, which node10 resolution consumes via `typings`. */
    "module": "commonjs",
    "moduleResolution": "node10",
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    /* Strictness: the backend is authoritative over gameplay, so type holes
       are treated as build failures rather than runtime surprises. */
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src/**/*", "test/**/*"],
  "exclude": ["node_modules", "dist"]
}
