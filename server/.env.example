# Copy to .env and adjust. Never commit a filled-in .env.

# Runtime
NODE_ENV=development

# NestJS REST gateway
PORT=3000
# Comma separated allow list. Left empty it allows any origin in development
# and blocks every cross-origin request in production.
CORS_ORIGINS=

# Colyseus authoritative realtime server
COLYSEUS_PORT=2567

# Datastores (see docker/docker-compose.yml).
# DATABASE_URL is optional: leave it unset and matches simply are not stored,
# which is how CI and a laptop-free setup run the server. Set it and finished
# matches are written to the `matches` table from `database/schema.sql`.
DATABASE_URL=postgresql://ludoverse:ludoverse@localhost:5432/ludoverse
REDIS_URL=redis://localhost:6379

# Firebase Auth service account — consumed from Phase 3 (Issue 3.1) onward
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# LiveKit media server — consumed from Phase 4 (Issue 4.1) onward
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
