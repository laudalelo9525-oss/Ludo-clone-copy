<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Runs the Ludo rules engine and its tests on plain .NET, so CI verifies the
    gameplay logic without a Unity installation or licence. The very same files
    compile inside Unity through Assets/Scripts/Gameplay/LudoVerse.Gameplay.asmdef
    and Assets/Tests/EditMode, which is why nothing here may reference UnityEngine.

    LangVersion is pinned to the version Unity 6 supports, so syntax that would
    fail in the Editor fails here first.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <AssemblyName>LudoVerse.Rules.Tests</AssemblyName>
    <RootNamespace>LudoVerse.Tests.Gameplay</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../client/Assets/Scripts/Gameplay/**/*.cs" />
    <Compile Include="../../client/Assets/Tests/EditMode/Gameplay/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>

</Project>
