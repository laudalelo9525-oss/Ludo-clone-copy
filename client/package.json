{
  "name": "ludoverse-client",
  "private": true,
  "version": "0.1.0",
  "description": "LudoVerse web client: runs in a browser, wraps to Android via Capacitor",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "colyseus.js": "^0.16.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "jsdom": "^25.0.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
